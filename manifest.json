{
  "manifest_version": 3,
  "name": "Image Translator",
  "version": "1.0.1",
  "description": "Reconhece e traduz textos em imagens, canvas, fundos CSS e páginas inteiras sem rolagem visível.",
  "permissions": ["storage", "activeTab", "scripting", "debugger"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Image Translator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["vendor/tesseract.min.js", "ocr.js", "layout.js", "visual.js", "translator.js", "content.js", "screenshot.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/worker.min.js", "vendor/tesseract-core.wasm.js", "vendor/tesseract-core.wasm"],
      "matches": ["<all_urls>"]
    }
  ]
}
